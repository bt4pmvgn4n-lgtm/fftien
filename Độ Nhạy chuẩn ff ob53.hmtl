<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI•QTiến - Siêu Cấu Hình Độ Nhạy OB53</title>
    <style>
        :root {
            --primary-color: #00ffcc;
            --secondary-color: #ff0055;
            --bg-dark: #060b14;
            --card-bg: rgba(10, 17, 34, 0.75);
            --text-color: #ffffff;
            --neon-glow: 0 0 15px rgba(0, 255, 204, 0.6);
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, sans-serif;
            background: 
                linear-gradient(rgba(6, 11, 20, 0.85), rgba(6, 11, 20, 0.95)),
                radial-gradient(circle at 50% 50%, #1a2c56 0%, #060b14 100%),
                repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0, 255, 204, 0.03) 2px, rgba(0, 255, 204, 0.03) 4px);
            background-size: cover;
            color: var(--text-color);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            box-sizing: border-box;
        }

        .container {
            width: 100%;
            max-width: 450px;
            background: var(--card-bg);
            padding: 35px 25px;
            border-radius: 24px;
            box-shadow: 0 0 40px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(0, 255, 204, 0.1);
            backdrop-filter: blur(15px);
            border: 2px solid rgba(0, 255, 204, 0.2);
            text-align: center;
            box-sizing: border-box;
            position: relative;
            overflow: hidden;
        }

        .container::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 20px; height: 20px;
            border-top: 3px solid var(--primary-color);
            border-left: 3px solid var(--primary-color);
        }
        .container::after {
            content: '';
            position: absolute;
            bottom: 0; right: 0; width: 20px; height: 20px;
            border-bottom: 3px solid var(--secondary-color);
            border-right: 3px solid var(--secondary-color);
        }

        .ai-avatar {
            width: 85px;
            height: 85px;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border-radius: 50%;
            margin: 0 auto 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 900;
            font-size: 26px;
            color: #fff;
            text-shadow: 0 0 10px rgba(0,0,0,0.5);
            box-shadow: 0 0 25px rgba(0, 255, 204, 0.4);
            animation: pulse 2.5s infinite alternate;
        }

        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 20px rgba(0, 255, 204, 0.4); }
            100% { transform: scale(1.06); box-shadow: 0 0 30px rgba(255, 0, 85, 0.6); }
        }

        h1 {
            color: #fff;
            font-size: 28px;
            font-weight: 800;
            margin: 0 0 5px 0;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            background: linear-gradient(to right, #fff, #a2b4dc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .ai-status {
            font-size: 13px;
            color: var(--primary-color);
            margin-bottom: 30px;
            font-weight: bold;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-shadow: 0 0 8px rgba(0, 255, 204, 0.3);
        }

        .form-group {
            margin-bottom: 22px;
            text-align: left;
        }

        label {
            display: block;
            font-size: 12px;
            margin-bottom: 8px;
            color: #8fa0c0;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: bold;
        }

        select, input {
            width: 100%;
            padding: 14px 16px;
            border-radius: 12px;
            background: rgba(5, 10, 25, 0.8);
            border: 1px solid rgba(0, 255, 204, 0.2);
            color: #fff;
            font-size: 15px;
            outline: none;
            transition: 0.3s ease;
            box-sizing: border-box;
        }

        select:focus, input:focus {
            border-color: var(--primary-color);
            box-shadow: var(--neon-glow);
            background: rgba(10, 20, 45, 0.9);
        }

        .password-wrapper {
            position: relative;
        }
        
        .toggle-password {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #8fa0c0;
            font-size: 12px;
            font-weight: bold;
            user-select: none;
            transition: 0.2s;
            letter-spacing: 0.5px;
        }

        .toggle-password:hover {
            color: var(--primary-color);
            text-shadow: var(--neon-glow);
        }

        .btn-action {
            width: 100%;
            padding: 16px;
            background: linear-gradient(90deg, #00ffcc, #ff0055);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            transition: 0.3s;
            box-sizing: border-box;
            margin-top: 10px;
            box-shadow: 0 4px 20px rgba(255, 0, 85, 0.3);
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(0, 255, 204, 0.6);
        }

        .ai-dialogue {
            background: rgba(0, 255, 204, 0.06);
            border: 1px solid var(--primary-color);
            padding: 14px;
            border-radius: 10px;
            font-size: 13px;
            color: #e2e8f0;
            margin-top: 25px;
            display: none;
            text-align: left;
            line-height: 1.5;
            box-shadow: inset 0 0 10px rgba(0, 255, 204, 0.1);
        }

        .result-box {
            margin-top: 25px;
            background: rgba(5, 10, 20, 0.85);
            border-radius: 16px;
            padding: 22px;
            display: none;
            border: 1px solid rgba(255, 0, 85, 0.25);
            box-shadow: 0 0 20px rgba(0,0,0,0.4);
        }

        .result-title {
            font-size: 15px;
            font-weight: 900;
            color: var(--secondary-color);
            margin-bottom: 18px;
            text-align: center;
            letter-spacing: 1.5px;
            text-shadow: 0 0 10px rgba(255, 0, 85, 0.3);
            text-transform: uppercase;
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            font-size: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .stat-row:last-child {
            border-bottom: none;
        }

        .stat-name {
            color: #cbd5e1;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .stat-icon {
            font-size: 16px;
            width: 20px;
            text-align: center;
        }

        .stat-val {
            font-weight: bold;
            color: #00ffaa;
            font-family: 'Courier New', Courier, monospace;
            font-size: 18px;
            text-shadow: 0 0 5px rgba(0, 255, 170, 0.3);
        }

        .highlight-row {
            background: rgba(255, 0, 85, 0.12);
            margin: 5px -22px;
            padding: 12px 22px;
            border-left: 3px solid var(--secondary-color);
        }

        #main-app-content {
            display: none;
        }
        
        .key-badge {
            background: rgba(0, 255, 170, 0.12);
            color: #00ffaa;
            padding: 10px 14px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: bold;
            display: block;
            margin-bottom: 22px;
            border: 1px solid rgba(0, 255, 170, 0.25);
            text-align: left;
            line-height: 1.4;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="ai-avatar">QT</div>
    <h1>AI•QTiến</h1>
    <div class="ai-status" id="app-status-title">⚡ HỆ THỐNG ĐANG KHÓA ⚡</div>

    <div id="login-section">
        <div class="form-group">
            <label for="app-password">🔑 Nhập Key Kích Hoạt App:</label>
            <div class="password-wrapper">
                <input type="password" id="app-password" placeholder="Nhập mã key của bạn tại đây...">
                <span class="toggle-password" id="eye-icon" onclick="togglePasswordVisibility()">HIỆN</span>
            </div>
        </div>
        <button class="btn-action" onclick="verifyKey()">🔐 Kích hoạt hệ thống</button>
        <div class="ai-dialogue" id="login-error-chat" style="display: none; border-color: #ff0055;"></div>
    </div>

    <div id="main-app-content">
        <div class="key-badge" id="key-expiry-status">Đang tải thời gian sử dụng...</div>

        <div class="form-group">
            <label for="device-brand">📱 Chọn dòng máy:</label>
            <select id="device-brand" onchange="updateModels()">
                <option value="">-- Click để chọn hệ máy --</option>
                <option value="ios">iOS (iPhone/iPad)</option>
                <option value="android">Android (Samsung, Realme...)</option>
                <option value="oppo">Oppo</option>
                <option value="xiaomi">Xiaomi / Redmi</option>
                <option value="vivo">Vivo</option>
            </select>
        </div>

        <div class="form-group">
            <label for="device-model">🛠️ Chọn máy đang sử dụng:</label>
            <select id="device-model" disabled>
                <option value="">-- Vui lòng chọn dòng máy trước --</option>
            </select>
        </div>

        <button class="btn-action" onclick="aiProcess()">🤖 Bắt đầu quét & tối ưu</button>

        <div class="ai-dialogue" id="ai-chat"></div>

        <div class="result-box" id="result-box">
            <div class="result-title" id="result-phone-name">KẾT QUẢ PHÂN TÍCH</div>
            
            <div class="stat-row">
                <span class="stat-name"><span class="stat-icon">👀</span>Nhìn Xung Quanh (General):</span>
                <span class="stat-val" id="val-general">0</span>
            </div>
            <div class="stat-row">
                <span class="stat-name"><span class="stat-icon">🔴</span>Red Dot Sight:</span>
                <span class="stat-val" id="val-reddot">0</span>
            </div>
            <div class="stat-row">
                <span class="stat-name"><span class="stat-icon">🔍</span>Ống Ngắm 2x:</span>
                <span class="stat-val" id="val-2x">0</span>
            </div>
            <div class="stat-row">
                <span class="stat-name"><span class="stat-icon">🔭</span>Ống Ngắm 4x:</span>
                <span class="stat-val" id="val-4x">0</span>
            </div>
            <div class="stat-row">
                <span class="stat-name"><span class="stat-icon">🎯</span>Ống Ngắm Sniper:</span>
                <span class="stat-val" id="val-sniper">0</span>
            </div>
            <div class="stat-row">
                <span class="stat-name"><span class="stat-icon">🔄</span>Nhìn Tự Do (Free Look):</span>
                <span class="stat-val" id="val-free">0</span>
            </div>
            
            <div class="stat-row highlight-row">
                <span class="stat-name" style="color: #ff0055; font-weight: bold;"><span class="stat-icon">🔘</span>Cỡ Nút Bắn (Gợi ý):</span>
                <span class="stat-val" id="val-button" style="color: #fff;">35%</span>
            </div>
        </div>
    </div>
</div>

<script>
    const keyConfig = {
        "NQT-281": "permanent",
        "NQT-6249": 3 * 24 * 60 * 60 * 1000, 
        "NQT-3624": 2 * 24 * 60 * 60 * 1000  
    };

    // Cơ sở dữ liệu cập nhật đầy đủ iPhone 16 và iPhone 17 mới nhất
    const deviceData = {
        ios: [
            "iPhone 7 / 7 Plus", "iPhone 8 / 8 Plus", "iPhone X / XS / XR", 
            "iPhone 11 / 11 Pro Max", "iPhone 12 / 12 Pro Max", "iPhone 13 / 13 Pro Max", 
            "iPhone 14 / 14 Pro Max", "iPhone 15 / 15 Pro Max", 
            "iPhone 16 / 16 Pro / 16 Pro Max", "iPhone 17 / 17 Pro / 17 Pro Max", 
            "iPad Gaming (Mọi dòng)"
        ],
        android: ["Galaxy S24 / S25 / S26 Ultra", "Galaxy A55 / A75 5G", "Realme 12 Pro / 13 Pro", "Asus ROG Phone 8 / 9 Pro", "Red Magic 9 / 10 Pro"],
        oppo: ["Oppo A79 / A98", "Oppo Reno 11 / 12 / 13 Pro", "Oppo Find X7 / X8 Pro"],
        xiaomi: ["Redmi Note 13 / 14 / 15 Pro", "Poco X6 / X7 / F6 Pro", "Xiaomi 14 / 15 / 16 Ultra"],
        vivo: ["Vivo Y38 / Y100", "Vivo V30 / V40 / V50 5G", "Vivo IQOO 12 / 13 Neo"]
    };

    let countdownInterval = null;
    let currentActiveKey = "";

    function togglePasswordVisibility() {
        const passwordInput = document.getElementById("app-password");
        const eyeIcon = document.getElementById("eye-icon");
        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            eyeIcon.innerText = "ẨN";
            eyeIcon.style.color = "#00ffcc";
        } else {
            passwordInput.type = "password";
            eyeIcon.innerText = "HIỆN";
            eyeIcon.style.color = "#8fa0c0";
        }
    }

    function verifyKey() {
        const inputKey = document.getElementById("app-password").value.trim();
        const errorBox = document.getElementById("login-error-chat");

        if (keyConfig.hasOwnProperty(inputKey)) {
            errorBox.style.display = "none";
            currentActiveKey = inputKey;

            let now = new Date().getTime();
            let expiryTime = localStorage.getItem("expiry_" + inputKey);

            if (!expiryTime) {
                if (keyConfig[inputKey] === "permanent") {
                    expiryTime = "permanent";
                } else {
                    expiryTime = now + keyConfig[inputKey];
                }
                localStorage.setItem("expiry_" + inputKey, expiryTime);
            }

            document.getElementById("login-section").style.display = "none";
            document.getElementById("main-app-content").style.display = "block";
            document.getElementById("app-status-title").innerText = "⚡ SIÊU ĐỘ NHẠY OB53 ⚡";

            startCountdown(inputKey, expiryTime);
        } else {
            errorBox.style.display = "block";
            errorBox.innerHTML = `<b>AI•QTiến:</b> ❌ Mã Key nhập không đúng hoặc không tồn tại trên máy chủ! Không thể mở khóa.`;
        }
    }

    function startCountdown(key, expiryTime) {
        const expiryStatus = document.getElementById("key-expiry-status");
        if (countdownInterval) clearInterval(countdownInterval);

        if (expiryTime === "permanent") {
            expiryStatus.innerHTML = `🔑 Key: <span style='color:#fff;'>${key}</span><br>⏳ Thời gian còn lại: <span style='color:#00ffcc;'>Vĩnh viễn ✨</span>`;
            return;
        }

        function updateTimer() {
            let now = new Date().getTime();
            let distance = expiryTime - now;

            if (distance <= 0) {
                clearInterval(countdownInterval);
                localStorage.removeItem("expiry_" + key);
                lockSystemDueToTimeout();
                return;
            }

            let days = Math.floor(distance / (1000 * 60 * 60 * 24));
            let hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            let minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            let seconds = Math.floor((distance % (1000 * 60)) / 1000);

            hours = hours < 10 ? "0" + hours : hours;
            minutes = minutes < 10 ? "0" + minutes : minutes;
            seconds = seconds < 10 ? "0" + seconds : seconds;

            expiryStatus.innerHTML = `🔑 Key: <span style='color:#fff;'>${key}</span><br>⏳ Còn lại: <span style='color:#ff0055;'>${days} ngày, ${hours}:${minutes}:${seconds}</span>`;
        }

        updateTimer();
        countdownInterval = setInterval(updateTimer, 1000);
    }

    function lockSystemDueToTimeout() {
        document.getElementById("device-brand").value = "";
        document.getElementById("device-model").innerHTML = '<option value="">-- Vui lòng chọn dòng máy trước --</option>';
        document.getElementById("device-model").disabled = true;
        document.getElementById("result-box").style.display = "none";
        document.getElementById("ai-chat").style.display = "none";
        document.getElementById("app-password").value = "";

        document.getElementById("main-app-content").style.display = "none";
        document.getElementById("login-section").style.display = "block";
        document.getElementById("app-status-title").innerText = "⚡ HỆ THỐNG ĐANG KHÓA ⚡";

        const errorBox = document.getElementById("login-error-chat");
        errorBox.style.display = "block";
        errorBox.innerHTML = `<b>AI•QTiến:</b> ⚠️ <b>HẾT HẠN!</b> Mã khóa đã hết thời gian sử dụng. Vui lòng nhập một Key khác để tiếp tục!`;
    }

    function updateModels() {
        const brandSelect = document.getElementById("device-brand");
        const modelSelect = document.getElementById("device-model");
        const selectedBrand = brandSelect.value;

        modelSelect.innerHTML = "";

        if (selectedBrand === "") {
            modelSelect.innerHTML = '<option value="">-- Vui lòng chọn dòng máy trước --</option>';
            modelSelect.disabled = true;
            return;
        }

        modelSelect.disabled = false;
        let defaultOpt = document.createElement("option");
        defaultOpt.value = "";
        defaultOpt.text = "-- Chọn máy đang sử dụng --";
        modelSelect.appendChild(defaultOpt);

        deviceData[selectedBrand].forEach(function(model) {
            let opt = document.createElement("option");
            opt.value = model;
            opt.text = model;
            modelSelect.appendChild(opt);
        });
    }

    function aiProcess() {
        const brand = document.getElementById("device-brand").value;
        const model = document.getElementById("device-model").value;
        const aiChat = document.getElementById("ai-chat");
        const resultBox = document.getElementById("result-box");

        if (!brand || !model) {
            alert("Vui lòng chọn đầy đủ dòng máy và thiết bị đang sử dụng!");
            return;
        }

        resultBox.style.display = "none";
        aiChat.style.display = "block";
        aiChat.style.borderColor = "#00ffcc";
        aiChat.innerHTML = `<b>AI•QTiến:</b> 📡 Đang kết nối máy chủ dữ liệu OB53... Đang tính toán cấu hình tối ưu riêng cho <b>${model}</b>...`;

        setTimeout(() => {
            aiChat.innerHTML = `<b>AI•QTiến:</b> ✅ Tối ưu thành công! Dưới đây là cấu hình độ nhạy kéo tâm OB53 (Chỉ số Max 200) hoàn hảo nhất cho thiết bị của bạn.`;

            let general = Math.floor(Math.random() * (198 - 170 + 1)) + 170;
            let reddot = Math.floor(Math.random() * (195 - 165 + 1)) + 165;
            let scope2x = Math.floor(Math.random() * (188 - 160 + 1)) + 160;
            let scope4x = Math.floor(Math.random() * (190 - 162 + 1)) + 162;
            let sniper = Math.floor(Math.random() * (115 - 75 + 1)) + 75;
            let freelook = Math.floor(Math.random() * (145 - 95 + 1)) + 95;
            
            let buttonSize = Math.floor(Math.random() * (40 - 30 + 1)) + 30 + "%";

            document.getElementById("result-phone-name").innerText = "ĐỘ NHẠY CHO: " + model.toUpperCase();
            document.getElementById("val-general").innerText = general;
            document.getElementById("val-reddot").innerText = reddot;
            document.getElementById("val-2x").innerText = scope2x;
            document.getElementById("val-4x").innerText = scope4x;
            document.getElementById("val-sniper").innerText = sniper;
            document.getElementById("val-free").innerText = freelook;
            document.getElementById("val-button").innerText = buttonSize;

            resultBox.style.display = "block";
        }, 1800);
    }
</script>

</body>
</html>